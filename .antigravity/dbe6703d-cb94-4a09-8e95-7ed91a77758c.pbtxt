underline underline-offset-4 hover:text-[#B9FF66] transition-colors\\\"\\n                >\\n                  {link.label}\\n                </a>\\n              ))}\\n            </nav>\\n\\n            {/* Social Icons */}\\n            <div className=\\\"flex items-center gap-5\\\">\\n              <a\\n                href=\\\"https://linkedin.com\\\"\\n                target=\\\"_blank\\\"\\n                rel=\\\"noreferrer\\\"\\n                className=\\\"w-[30px] h-[30px] rounded-full bg-white text-black flex items-center justify-center hover:bg-[#B9FF66] transition-colors\\\"\\n                aria-label=\\\"LinkedIn\\\"\\n              >\\n                <LinkedInIcon className=\\\"w-4 h-4\\\" />\\n              </a>\\n              <a\\n                href=\\\"https://facebook.com\\\"\\n                target=\\\"_blank\\\"\\n                rel=\\\"noreferrer\\\"\\n                className=\\\"w-[30px] h-[30px] rounded-full bg-white text-black flex items-center justify-center hover:bg-[#B9FF66] transition-colors\\\"\\n                aria-label=\\\"Facebook\\\"\\n              >\\n                <FacebookIcon className=\\\"w-4 h-4\\\" />\\n              </a>\\n              <a\\n                href=\\\"https://twitter.com\\\"\\n                target=\\\"_blank\\\"\\n                rel=\\\"noreferrer\\\"\\n                className=\\\"w-[30px] h-[30px] rounded-full bg-white text-black flex items-center justify-center hover:bg-[#B9FF66] transition-colors\\\"\\n                aria-label=\\\"Twitter / X\\\"\\n              >\\n                <TwitterIcon className=\\\"w-4 h-4\\\" />\\n              </a>\\n            </div>\\n          </div>\\n\\n          {/* Middle Row: Contact Info & Newsletter Subscription */}\\n          <div className=\\\"flex flex-col lg:flex-row items-start justify-between gap-10\\\">\\n            {/* Left: Contact Info */}\\n            <div className=\\\"flex flex-col items-start gap-6 max-w-[340px]\\\">\\n       