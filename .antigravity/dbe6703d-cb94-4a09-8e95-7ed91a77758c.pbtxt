    command_line: "node -e \"\nconst fs = require(\'fs\');\nconst zlib = require(\'zlib\');\nconst buf = fs.readFileSync(\'public/assets/aistudio/2_88a1ec16.png\');\nconst width = buf.readUInt32BE(16);\nconst height = buf.readUInt32BE(20);\nconsole.log({ width, height });\n\nlet pos = 8;\nconst idatChunks = [];\nwhile (pos < buf.length) {\n  const len = buf.readUInt32BE(pos);\n  const type = buf.toString(\'ascii\', pos + 4, pos + 8);\n  if (type === \'IDAT\') idatChunks.push(buf.slice(pos + 8, pos + 8 + len));\n  pos += 12 + len;\n}\nconst compressed = Buffer.concat(idatChunks);\nzlib.inflate(compressed, (err, raw) => {\n  if (err) return console.error(err);\n  const stride = 1 + width * 4;\n  let minY = height, maxY = 0, minX = width, maxX = 0;\n  for (let y = 0; y < height; y++) {\n    const rowOffset = y * stride + 1;\n    for (let x = 0; x < width; x++) {\n      if (raw[rowOffset + x * 4 + 3] > 20) {\n        if (y < minY) minY = y;\n        if (y > maxY) maxY = y;\n        if (x < minX) minX = x;\n        if (x > maxX) maxX = x;\n      }\n    }\n  }\n  console.log({ minY, maxY, minX, maxX });\n});\n\""
