        instruction: "import React from \'react\';\nimport { HeroIllustration } from \'./PositivusIllustrations\';\n\ninterface HeroProps {\n  onCtaClick?: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({ onCtaClick }) => {\n  return (\n    <section className=\"w-full pt-6 pb-12 sm:pt-10 sm:pb-16 overflow-hidden\">\n      <div className=\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col-reverse lg:flex-row items-center justify-between gap-10 lg:gap-16\">\n          {/* Left Text Block (Frame 13) */}\n          <div className=\"w-full lg:max-w-[531px] flex flex-col items-start gap-7 sm:gap-9\">\n            {/* Title (Main Heading rule: Replace main headings with \'Title\') */}\n            <h1 className=\"font-[\'Space_Grotesk\'] font-medium text-[42px] sm:text-[52px] lg:text-[60px] leading-[52px] sm:leading-[64px] lg:leading-[77px] text-black tracking-tight text-balance\">\n              Title\n            </h1>\n\n            {/* Paragraph (rule: Replace paragraph content with Lorem Ipsum matching length & line count) */}\n            <p className=\"font-[\'Space_Grotesk\'] font-normal text-[18px] sm:text-[20px] leading-[26px] sm:leading-[28px] text-black max-w-[498px]\">\n              Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.\n            </p>\n\n            {/* Button (rule: Button labels may use \"Learn More\", \"Get Started\", or \"Explore\") */}\n            <button\n              onClick={onCtaClick}\n              className=\"font-[\'Space_Grotesk\'] text-[18px] sm:text-[20px] font-normal text-white bg-[#191A23] rounded-[14px] px-[35px] py-[20px] hover:bg-[#B9FF66] hover:text-[#191A23] transition-all duration-200 cursor-pointer shadow-md hover:shadow-lg whitespace-nowrap\"\n            >\n              Get Started\n            </button>\n          </div>\n\n          {/* Right Hero Illustration */}\n          <div className=\"w-full lg:w-auto flex justify-center lg:justify-end shrink-0\">\n            <HeroIllustration />\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
