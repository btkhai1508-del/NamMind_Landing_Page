        instruction: "import React from \'react\';\n\nexport const Logotypes: React.FC = () => {\n  const text = \'Th\341\273\255 th\303\241ch tr\306\260c ti\341\272\277p! 2 ng\303\240y Affiliate 100 tri\341\273\207u/ th\303\241ng ch\341\273\211 b\341\272\261ng chi\341\272\277c \304\221i\341\273\207n tho\341\272\241i\';\n  const repeatCount = 4;\n\n  return (\n    <section className=\"w-full py-6 sm:py-8 overflow-hidden select-none\" aria-label=\"LED Announcement Ticker\">\n      <div className=\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* LED Display Board */}\n        <div className=\"relative w-full bg-[#191A23] border-2 border-[#191A23] rounded-[20px] sm:rounded-[26px] py-4 sm:py-5 overflow-hidden shadow-[0px_5px_0px_#191A23]\">\n          {/* Subtle LED Grid texture */}\n          <div className=\"absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(185,255,102,0.08)_1px,transparent_1px)] bg-[size:8px_8px] pointer-events-none\" />\n\n          {/* Continuous running text */}\n          <div className=\"flex overflow-hidden\">\n            <div className=\"animate-marquee flex items-center gap-8 whitespace-nowrap text-[#B9FF66] font-[\'Space_Grotesk\'] font-bold text-[18px] sm:text-[22px] tracking-wide\">\n              {Array.from({ length: repeatCount }).map((_, i) => (\n                <div key={i} className=\"flex items-center gap-8 shrink-0\">\n                  <span className=\"drop-shadow-[0_0_10px_rgba(185,255,102,0.5)]\">\n                    {text}\n                  </span>\n                  {/* Glowing LED separator dot */}\n                  <span className=\"w-3 h-3 rounded-full bg-[#B9FF66] shadow-[0_0_8px_#B9FF66] shrink-0\" />\n                </div>\n              ))}\n            </div>\n\n            <div aria-hidden=\"true\" className=\"animate-marquee flex items-center gap-8 whitespace-nowrap text-[#B9FF66] font-[\'Space_Grotesk\'] font-bold text-[18px] sm:text-[22px] tracking-wide\">\n              {Array.from({ length: repeatCount }).map((_, i) => (\n                <div key={`dup-${i}`} className=\"flex items-center gap-8 shrink-0\">\n                  <span className=\"drop-shadow-[0_0_10px_rgba(185,255,102,0.5)]\">\n                    {text}\n                  </span>\n                  <span className=\"w-3 h-3 rounded-full bg-[#B9FF66] shadow-[0_0_8px_#B9FF66] shrink-0\" />\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
