        instruction: "import React, { useState } from \'react\';\n\ninterface RegisterModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nexport const RegisterModal: React.FC<RegisterModalProps> = ({ isOpen, onClose }) => {\n  const [name, setName] = useState(\'\');\n  const [phone, setPhone] = useState(\'\');\n  const [email, setEmail] = useState(\'\');\n  const [isSuccess, setIsSuccess] = useState(false);\n\n  if (!isOpen) return null;\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!name && !phone && !email) return;\n    setIsSuccess(true);\n    setTimeout(() => {\n      setIsSuccess(false);\n      setName(\'\');\n      setPhone(\'\');\n      setEmail(\'\');\n      onClose();\n    }, 2500);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fadeIn\">\n      {/* Click outside backdrop */}\n      <div className=\"absolute inset-0\" onClick={onClose} />\n\n      {/* Pop-up Window Container */}\n      <div className=\"relative bg-white rounded-[28px] sm:rounded-[36px] max-w-[540px] w-full p-6 sm:p-10 border-2 border-[#191A23] shadow-2xl z-10 max-h-[92vh] overflow-y-auto\">\n        {/* Close Button \342\234\225 */}\n        <button\n          onClick={onClose}\n          className=\"absolute top-5 right-5 sm:top-6 sm:right-6 w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 flex items-center justify-center font-bold text-gray-700 transition-colors cursor-pointer\"\n          aria-label=\"\304\220\303\263ng c\341\273\255a s\341\273\225\"\n        >\n          \342\234\225\n        </button>\n\n        {/* Title */}\n        <div className=\"flex flex-col gap-1 pr-6\">\n          <h2 className=\"font-[\'Space_Grotesk\'] font-extrabold text-[24px] sm:text-[30px] leading-[30px] sm:leading-[36px] text-black tracking-tight uppercase\">\n            <span className=\"block\">TH\341\273\254 TH\303\201CH 2 NG\303\200Y MI\341\273\204N PH\303\215 -</span>\n            <span className=\"block\">B\303\215 M\341\272\254T</span>\n            <span className=\"block\">D\303\222NG TI\341\273\200N 30 TRI\341\273\206U-</span>\n            <span className=\"block\">AFFILIATE-</span>\n            <span className=\"block\">CH\341\273\210 C\341\272\246N (B\341\272\244M \304\220I\341\273\206N THO\341\272\240I)</span>\n          </h2>\n        </div>\n\n        {/* Subtitle */}\n        <p className=\"mt-4 font-[\'Space_Grotesk\'] font-medium text-[15px] sm:text-[17px] leading-[22px] sm:leading-[25px] text-black\">\n          Ch\341\273\211 7 ch\341\273\227 duy nh\341\272\245t- \304\220i\341\273\201n th\303\264ng tin c\341\273\247a b\341\272\241n xu\341\273\221ng d\306\260\341\273\233i \304\221\341\273\203 \304\221\306\260\341\273\243c gi\341\273\257 ch\341\273\227:\n        </p>\n\n        {/* 3 Textboxes Form */}\n        <form onSubmit={handleSubmit} className=\"mt-6 flex flex-col gap-3.5 sm:gap-4\">\n          {/* \303\224 1: T\303\252n c\341\273\247a b\341\272\241n */}\n          <div>\n            <input\n              type=\"text\"\n              required\n              placeholder=\"T\303\252n c\341\273\247a b\341\272\241n\"\n              value={name}\n              onChange={(e) => setName(e.target.value)}\n              className=\"w-full h-[54px] sm:h-[58px] px-5 bg-white border border-black rounded-[16px] font-[\'Space_Grotesk\'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:ring-2 focus:ring-[#B9FF66]\"\n            />\n          </div>\n\n          {/* \303\224 2: S\304\220T c\341\273\247a b\341\272\241n */}\n          <div>\n            <input\n              type=\"tel\"\n              required\n              placeholder=\"S\304\220T c\341\273\247a b\341\272\241n\"\n              value={phone}\n              onChange={(e) => setPhone(e.target.value)}\n              className=\"w-full h-[54px] sm:h-[58px] px-5 bg-white border border-black rounded-[16px] font-[\'Space_Grotesk\'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:ring-2 focus:ring-[#B9FF66]\"\n            />\n          </div>\n\n          {/* \303\224 3: Email c\341\273\247a b\341\272\241n */}\n          <div>\n            <input\n              type=\"email\"\n              required\n              placeholder=\"Email c\341\273\247a b\341\272\241n\"\n              value={email}\n              onChange={(e) => setEmail(e.target.value)}\n              className=\"w-full h-[54px] sm:h-[58px] px-5 bg-white border border-black rounded-[16px] font-[\'Space_Grotesk\'] text-[16px] text-black placeholder:text-[#898989] focus:outline-none focus:ring-2 focus:ring-[#B9FF66]\"\n            />\n          </div>\n\n          {/* Success message */}\n          {isSuccess && (\n            <div className=\"p-3 bg-[#B9FF66] text-black text-center font-[\'Space_Grotesk\'] font-bold rounded-[14px] text-sm border border-black animate-fadeIn\">\n              \342\234\223 \304\220\303\243 gi\341\273\257 ch\341\273\227 th\303\240nh c\303\264ng! V\303\251 mi\341\273\205n ph\303\255 \304\221ang \304\221\306\260\341\273\243c g\341\273\255i \304\221\341\272\277n b\341\272\241n.\n            </div>\n          )}\n\n          {/* Submit Button */}\n          <button\n            type=\"submit\"\n            className=\"w-full h-[58px] sm:h-[62px] bg-[#191A23] text-white font-[\'Space_Grotesk\'] font-bold text-[17px] sm:text-[19px] rounded-[16px] hover:bg-[#B9FF66] hover:text-[#191A23] transition-all duration-200 cursor-pointer shadow-md hover:shadow-xl uppercase tracking-wider border border-[#191A23] flex items-center justify-center mt-1\"\n          >\n            G\341\273\254I V\303\211 MI\341\273\204N PH\303\215 CHO T\303\224I\n          </button>\n\n          {/* Faint grey text */}\n          <p className=\"font-[\'Space_Grotesk\'] text-[13px] text-neutral-400 text-center select-none pt-1\">\n            th\303\264ng tin c\341\273\247a b\341\272\241n \304\221\306\260\341\273\243c b\341\272\243o m\341\272\255t tuy\341\273\207t \304\221\341\273\221i\n          </p>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/RegisterModal.tsx"
        }
        overwrite: true
      }
    }
