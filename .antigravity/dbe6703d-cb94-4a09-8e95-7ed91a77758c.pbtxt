    content: "import React from \'react\';\n\ninterface SectionHeadingProps {\n  title?: string;\n  description?: string;\n  className?: string;\n  maxWidthDesc?: string;\n}\n\nexport const SectionHeading: React.FC<SectionHeadingProps> = ({\n  title = \'Section Title\',\n  description = \'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\',\n  className = \'\',\n  maxWidthDesc = \'max-w-[580px]\',\n}) => {\n  return (\n    <div className={`flex flex-col md:flex-row items-start md:items-center gap-5 md:gap-10 mb-10 md:mb-16 ${className}`}>\n      {/* Signature Positivus Green Highlight Badge */}\n      <div className=\"inline-flex items-center px-[7px] py-0 bg-[#B9FF66] rounded-[7px] shrink-0\">\n        <h2 className=\"font-[\'Space_Grotesk\'] font-medium text-[32px] sm:text-[38px] md:text-[40px] leading-[42px] sm:leading-[48px] md:leading-[51px] text-black tracking-tight\">\n          {title}\n        </h2>\n      </div>\n      {/* Subheading explanation */}\n      {description && (\n        <p className={`font-[\'Space_Grotesk\'] font-normal text-[16px] sm:text-[18px] leading-[23px] text-black ${maxWidthDesc}`}>\n          {description}\n        </p>\n      )}\n    </div>\n  );\n};\n"
