      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { SectionHeading } from \'./SectionHeading\';\\n\\ninterface TestimonialsProps {\\n  onCtaClick?: () => void;\\n}\\n\\nexport const Testimonials: React.FC<TestimonialsProps> = ({ onCtaClick }) => {\\n  return (\\n    <section id=\\\"testimonials\\\" className=\\\"w-full py-12 sm:py-16\\\">\\n      <div className=\\\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\\\">\\n        {/* Ti\303\252u \304\221\341\273\201 Section Title 5 */}\\n        <SectionHeading\\n          title=\\\"Tin nh\341\272\257n t\341\273\253 Nam Anh\\\"\\n          titleClassName=\\\"font-bold\\\"\\n          description=\\\"\\\"\\n        />\\n\\n        {/* Khung ch\341\273\251a th\306\260 ng\341\273\217 chu\341\272\251n Figma Positivus */}\\n        <div className=\\\"bg-[#191A23] rounded-[45px] py-10 sm:py-14 lg:py-16 px-6 sm:px-10 lg:px-14 flex flex-col items-center positivus-shadow\\\">\\n          <div className=\\\"w-full max-w-[880px] flex flex-col items-start\\\">\\n            <div className=\\\"relative w-full bg-[#21241D] border-2 border-[#B9FF66] rounded-[36px] sm:rounded-[45px] p-6 sm:p-10 lg:p-12 shadow-2xl\\\">\\n              \\n              {/* Header t\303\241c gi\341\272\243 Nam Anh \304\221\306\260a l\303\252n tr\303\252n \304\221\341\272\247u theo y\303\252u c\341\272\247u */}\\n              <div className=\\\"flex items-center gap-4 sm:gap-5 pb-6 mb-6 border-b border-white/15 w-full\\\">\\n                <div className=\\\"w-14 h-14 sm:w-16 sm:h-16 rounded-full overflow-hidden border-2 border-[#B9FF66] shrink-0 bg-neutral-900 shadow-md\\\">\\n                  <img\\n                    src=\\\"/assets/aistudio/2_88a1ec16.png\\\"\\n                    alt=\\\"Nam Anh\\\"\\n                    className=\\\"w-full h-full object-cover object-top\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <h4 className=\\\"font-[\'Space_Grotesk\'] font-bold text-[20px] sm:text-[24px] leading-tight text-[#B9FF66]\\\">\\n                    Nam Anh\\n                  </h4>\\n                  <p className=\\\"font-[\'Space_Grotesk\'] font-normal text-[14px] sm:text-[16px] text-white/90 mt-1\\\">\\n                    \\\"T\341\273\253 m\341\273\231t sinh vi\303\252n b\341\272\255n r\341\273\231n, m\303\271 c\303\264ng ngh\341\273\207 \304\221\341\272\277n ki\341\272\277m \304\221\306\260\341\273\243c th\303\252m h\303\240ng tr\304\203m tri\341\273\207u nh\341\273\235 Affiliate\\\"\\n                  </p>\\n                </div>\\n              </div>\\n\\n              {/* N\341\273\231i dung b\341\273\251c th\306\260: Kh\303\264ng d\303\271ng background xanh l\303\241 l\341\273\243t, ch\341\273\211 highlight v\303\240 in \304\221\341\272\255m ch\341\273\257 */}\\n              <div className=\\\"space-y-4 font-[\'Space_Grotesk\'] text-[16px] sm:text-[18px] leading-[26px] sm:leading-[30px] text-white\\\">\\n                <p className=\\\"font-bold text-[18px] sm:text-[21px] text-[#B9FF66]\\\">\\n                  \360\237\226\244 Th\303\242n g\341\273\255i b\341\272\241n \342\200\223 ng\306\260\341\273\235i \304\221ang v\341\272\255t l\341\273\231n \304\221\341\273\203 ki\341\272\277m ti\341\273\201n v\303\240 gi\341\273\257 ti\341\273\201n\342\200\246\\n                </p>\\n\\n                <div className=\\\"space-y-1 text-white/95\\\">\\n                  <p className=\\\"font-medium text-[17px] sm:text-[19px]\\\">B\341\272\241n gi\341\273\217i.</p>\\n                  <p className=\\\"font-medium text-[17px] sm:text-[19px]\\\">B\341\272\241n c\303\263 t\303\242m.</p>\\n                  <p className=\\\"font-bold text-[17px] sm:text-[19px] text-[#B9FF66]\\\">\\n                    Nh\306\260ng v\341\272\253n ch\306\260a h\303\240i l\303\262ng v\341\273\233i thu nh\341\272\255p....\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"space-y-1 text-white/90\\\">\\n                  <p>R\303\265 r\303\240ng b\341\272\241n kh\303\264ng k\303\251m, kh\303\264ng h\341\273\201...</p>\\n                  <p className=\\\"italic text-white/70\\\">(t\303\264i bi\341\272\277t ch\341\272\257c \304\221i\341\273\201u \304\221\303\263)</p>\\n                  <p className=\\\"font-medium text-white pt-1\\\">\\n                    Ch\341\273\211 l\303\240 b\341\272\241n \304\221ang m\341\272\257c k\341\272\271t trong m\303\264 h\303\254nh c\305\251, kh\303\264ng t\341\272\241o ra d\303\262ng ti\341\273\201n.\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"space-y-1 text-white/90 pt-1\\\">\\n                  <p className=\\\"font-bold text-[#B9FF66]\\\">2026 r\341\273\223i\342\200\246</p>\\n                  <p>A.I \304\221ang \304\203n s\341\272\241ch c\303\264ng vi\341\273\207c t\341\273\253 \304\221\306\241n gi\341\272\243n \304\221\341\272\277n ph\341\273\251c t\341\272\241p.</p>\\n                  <p className=\\\"font-bold text-white\\\">L\303\240m thu\303\252 kh\303\264ng c\341\273\251u \304\221\306\260\341\273\243c b\341\272\241n.</p>\\n                  <p>Kinh doanh ki\341\273\203u c\305\251 ch\341\273\211 khi\341\272\277n b\341\272\241n l\303\240m nhi\341\273\201u h\306\241n m\303\240 ti\341\273\201n ch\341\272\263ng t\304\203ng.</p>\\n                </div>\\n\\n                <p className=\\\"text-white/95\\\">\\n                  T\303\264i t\341\273\253ng ch\341\272\255t v\341\272\255t 10 n\304\203m v\341\273\233i \304\221\341\273\247 c\303\241c ng\303\240nh ngh\341\273\201 m\303\240 v\341\272\253n kh\303\264ng \304\221\341\273\247 duy tr\303\254 cu\341\273\231c s\341\273\221ng \341\273\237 m\341\273\251c b\303\254nh th\306\260\341\273\235ng \342\200\246 ch\341\273\211 \304\221\341\273\203 nh\341\272\255n ra v\341\272\245n \304\221\341\273\201 kh\303\264ng ph\341\272\243i \341\273\237 t\303\264i \342\200\223 m\303\240 \341\273\237 m\303\264 h\303\254nh.\\n                </p>\\n\\n                <div className=\\\"pt-2\\\">\\n                  <p className=\\\"font-extrabold text-[19px] sm:text-[22px] text-[#B9FF66]\\\">\\n                    Gi\341\272\243i ph\303\241p? Affiliate-T\341\273\261 \304\220\341\273\231ng.\\n                  </p>\\n                  <p className=\\\"font-bold text-white mt-1\\\">\\n                    M\341\273\231t h\341\273\207 th\341\273\221ng \304\221\303\243 d\341\273\261ng s\341\272\265n, b\341\272\241n ch\341\273\211 vi\341\273\207c c\341\272\247m \304\221i\341\273\207n tho\341\272\241i b\341\272\245m, v\303\240 2 ng\303\240y sau c\303\263 kh\303\241ch th\341\272\255t, ti\341\273\201n th\341\272\255t.\\n                  </p>\\n                </div>\\n\\n                <p className=\\\"font-bold text-[18px] sm:text-[21px] text-[#B9FF66] pt-2\\\">\\n                  N\341\272\277u b\341\272\241n c\303\262n \304\221\341\273\215c \304\221\341\272\277n \304\221\303\242y, b\341\272\241n v\341\272\253n c\303\262n c\341\273\255a \304\221\341\273\203 \304\221\341\273\225i \304\221\341\273\235i.\\n                </p>\\n              </div>\\n\\n            </div>\\n          </div>\\n\\n          {/* Thanh k\303\252u g\341\273\215i h\303\240nh \304\221\341\273\231ng ph\303\255a d\306\260\341\273\233i */}\\n          {onCtaClick && (\\n            <div className=\\\"mt-10 pt-6 border-t border-white/15 w-full flex flex-col sm:flex-row items-center justify-between gap-4\\\">\\n              <p className=\\\"text-white/80 text-[14px] sm:text-[16px] text-center sm:text-left\\\">\\n                \342\232\241 \304\220\341\273\253ng \304\221\341\273\203 m\303\264 h\303\254nh c\305\251 gi\341\273\233i h\341\272\241n b\341\272\241n \342\200\224 Nh\341\272\255n v\303\251 tham gia th\341\273\255 th\303\241ch 2 ng\303\240y mi\341\273\205n ph\303\255\\n              </p>\\n              <button\\n                onClick={onCtaClick}\\n                className=\\\"bg-[#B9FF66] text-[#191A23] px-6 sm:px-8 py-3.5 rounded-[14px] font-[\'Space_Grotesk\'] font-bold text-[15px] sm:text-[16px] hover:bg-white transition-all cursor-pointer border border-[#B9FF66] whitespace-nowrap shadow-md hover:-translate-y-0.5\\\"\\n              >\\n                Gi\341\273\257 Ch\341\273\227 C\303\271ng Nam Anh Ngay\\n              </button>\\n            </div>\\n          )}\\n        </div>\\n      </div>\\n    </section>\\n  );\\n};\\n\", \"Description\":\"Move Nam Anh author bar to the top of the letter, remove light green background boxes, keep bold and green text highlights\", \"Overwrite\":true, \"TargetFile\":\"/src/components/Testimonials.tsx\", \"toolAction\":\"Updating Testimonials component\", \"toolSummary\":\"Move author to top and refine highlights in Testimonials\"}"
