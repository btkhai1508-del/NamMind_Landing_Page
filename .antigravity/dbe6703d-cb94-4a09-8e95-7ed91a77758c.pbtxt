        instruction: "import React from \'react\';\n\ninterface CtaBannerProps {\n  onCtaClick?: () => void;\n}\n\nexport const CtaBanner: React.FC<CtaBannerProps> = ({ onCtaClick }) => {\n  return (\n    <section className=\"w-full py-8 sm:py-14\">\n      <div className=\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-[#F3F3F3] border-2 border-[#191A23] rounded-[45px] p-8 sm:p-12 lg:p-16 text-center positivus-shadow flex flex-col items-center\">\n          \n          {/* Main Title 2 lines */}\n          <div className=\"max-w-[900px] text-center\">\n            <h2 className=\"font-[\'Space_Grotesk\'] text-black tracking-tight\">\n              <span className=\"block font-bold text-[22px] sm:text-[28px] md:text-[34px] lg:text-[38px] leading-[30px] sm:leading-[38px] md:leading-[46px] text-neutral-900 mb-1 sm:mb-2\">\n                N\341\272\277u b\341\272\241n th\341\272\245y m\303\254nh trong b\341\272\245t k\341\273\263 d\303\262ng n\303\240o \341\273\237 tr\303\252n...\n              </span>\n              <span className=\"block font-black text-[24px] sm:text-[32px] md:text-[38px] lg:text-[44px] leading-[32px] sm:leading-[42px] md:leading-[50px] uppercase text-black\">\n                Th\303\254 TH\341\273\254 TH\303\201CH 2 NG\303\200Y n\303\240y sinh ra ch\303\255nh x\303\241c cho b\341\272\241n!\n              </span>\n            </h2>\n          </div>\n\n          {/* Subtitle / Quote */}\n          <p className=\"mt-4 sm:mt-6 font-[\'Space_Grotesk\'] text-[18px] sm:text-[22px] md:text-[24px] leading-[28px] sm:leading-[34px] text-neutral-800 text-center max-w-[850px]\">\n            <span className=\"font-medium\">V\303\240 b\341\272\241n s\341\272\275 t\341\273\261 h\341\273\217i: </span>\n            <span className=\"font-bold italic\">\"T\341\272\241i sao \304\221\341\272\277n gi\341\273\235 n\303\240y m\303\254nh m\341\273\233i bi\341\272\277t \304\221\341\272\277n Affiliate\"</span>\n          </p>\n\n          {/* 