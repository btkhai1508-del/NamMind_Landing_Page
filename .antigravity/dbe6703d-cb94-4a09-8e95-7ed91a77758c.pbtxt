    command_line: "node -e \'\nconst sharp = require(\"sharp\");\n\nasync function exportCrops() {\n  const trimmedBuf = await sharp(\"public/assets/aistudio/2_88a1ec16.png\").trim().toBuffer();\n  \n  // Crop 1: height 2150 (around hands / navel)\n  await sharp(trimmedBuf).extract({ left: 0, top: 0, width: 1987, height: 2150 }).toFile(\"public/assets/aistudio/crop_test_2150.png\");\n  \n  // Crop 2: height 2280 (just below hands / navel)\n  await sharp(trimmedBuf).extract({ left: 0, top: 0, width: 1987, height: 2280 }).toFile(\"public/assets/aistudio/crop_test_2280.png\");\n\n  // Crop 3: height 2400 (lower waist)\n  await sharp(trimmedBuf).extract({ left: 0, top: 0, width: 1987, height: 2400 }).toFile(\"public/assets/aistudio/crop_test_2400.png\");\n  \n  console.log(\"Exported test crops successfully\");\n}\nexportCrops();\n\'"
    proposed_command_line: "node -e \'\nconst sharp = require(\"sharp\");\n\nasync function exportCrops() {\n  const trimmedBuf = await sharp(\"public/assets/aistudio/2_88a1ec16.png\").trim().toBuffer();\n  \n  // Crop 1: height 2150 (around hands / navel)\n  await sharp(trimmedBuf).extract({ left: 0, top: 0, width: 1987, height: 2150 }).toFile(\"public/assets/aistudio/crop_test_2150.png\");\n  \n  // Crop 2: height 2280 (just below hands / navel)\n  await sharp(trimmedBuf).extract({ left: 0, top: 0, width: 1987, height: 2280 }).toFile(\"public/assets/aistudio/crop_test_2280.png\");\n\n  // Crop 3: height 2400 (lower waist)\n  await sharp(trimmedBuf).extract({ left: 0, top: 0, width: 1987, height: 2400 }).toFile(\"public/assets/aistudio/crop_test_2400.png\");\n  \n  console.log(\"Exported test crops successfully\");\n}\nexportCrops();\n\'"
