  view_file {
    absolute_path_uri: "file:///src/components/Logotypes.tsx"
    end_line: 38
    content: "import React from \'react\';\nimport {\n  AmazonLogo,\n  DribbbleLogo,\n  HubSpotLogo,\n  NotionLogo,\n  NetflixLogo,\n  ZoomLogo,\n} from \'./PositivusIcons\';\n\nexport const Logotypes: React.FC = () => {\n  return (\n    <section className=\"w-full py-8 sm:py-12 overflow-hidden\" aria-label=\"Partner logotypes\">\n      <div className=\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 items-center justify-items-center gap-8 sm:gap-10 grayscale opacity-80 hover:grayscale-0 hover:opacity-100 transition-all duration-300\">\n          <div className=\"flex items-center justify-center p-2 text-neutral-800 hover:text-black transition-colors\">\n            <AmazonLogo className=\"h-8 max-w-[120px]\" />\n          </div>\n          <div className=\"flex items-center justify-center p-2 text-neutral-800 hover:text-black transition-colors\">\n            <DribbbleLogo className=\"h-8\" />\n          </div>\n          <div className=\"flex items-center justify-center p-2 text-neutral-800 hover:text-black transition-colors\">\n            <HubSpotLogo className=\"h-8\" />\n          </div>\n          <div className=\"flex items-center justify-center p-2 text-neutral-800 hover:text-black transition-colors\">\n            <NotionLogo className=\"h-8\" />\n          </div>\n          <div className=\"flex items-center justify-center p-2 text-neutral-800 hover:text-black transition-colors\">\n            <NetflixLogo className=\"h-8\" />\n          </div>\n          <div className=\"flex items-center justify-center p-2 text-neutral-800 hover:text-black transition-colors\">\n            <ZoomLogo className=\"h-8\" />\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 39
    num_bytes: 1703
    line_range_bytes: 1703
  }
}
