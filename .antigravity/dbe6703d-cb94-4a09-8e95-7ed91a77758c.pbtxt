  view_file {
    absolute_path_uri: "file:///src/components/CaseStudies.tsx"
    end_line: 57
    content: "import React from \'react\';\nimport { SectionHeading } from \'./SectionHeading\';\nimport { ArrowGreenLink } from \'./PositivusIcons\';\n\nexport const CaseStudies: React.FC = () => {\n  const cases = [\n    {\n      id: 1,\n      text: \'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud.\',\n    },\n    {\n      id: 2,\n      text: \'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud.\',\n    },\n    {\n      id: 3,\n      text: \'Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud.\',\n    },\n  ];\n\n  return (\n    <section id=\"cases\" className=\"w-full py-12 sm:py-16\">\n      <div className=\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\">\n        <SectionHeading\n          title=\"Section Title 2\"\n          description=\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim.\"\n        />\n\n        {/* Dark Container with 3 columns */}\n        <div className=\"bg-[#191A23] rounded-[45px] p-8 sm:p-14 lg:p-16\">\n          <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-0 lg:divide-x lg:divide-white/30\">\n            {cases.map((item, idx) => (\n              <div\n                key={item.id}\n                className={`flex flex-col justify-between items-start gap-5 ${\n                  idx === 0 ? \'lg:pr-12\' : idx === 1 ? \'lg:px-12\' : \'lg:pl-12\'\n                }`}\n              >\n                <p className=\"font-[\'Space_Grotesk\'] font-normal text-[16px] sm:text-[18px] leading-[23px] text-white\">\n                  {item.text}\n                </p>\n\n                <a\n                  href=\"#contact\"\n                  className=\"group flex items-center gap-3 font-[\'Space_Grotesk\'] font-normal text-[18px] sm:text-[20px] leading-[28px] text-[#B9FF66] hover:underline cursor-pointer pt-2\"\n                >\n                  <span>Learn More</span>\n                  <ArrowGreenLink className=\"w-[18px] h-[18px]\" />\n                </a>\n              </div>\n            ))}\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
