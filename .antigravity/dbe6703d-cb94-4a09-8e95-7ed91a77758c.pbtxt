font-[\'Space_Grotesk\'] font-bold text-[18px] sm:text-[21px] md:text-[23px] text-[#191A23] flex items-center justify-center gap-2\\\">\\n            <span className=\\\"text-[#0E7E49] text-xl sm:text-2xl font-black\\\">\342\206\222</span>\\n            <span>H\341\273\207 th\341\273\221ng ra kh\303\241ch th\341\272\255t, ti\341\273\201n th\341\272\255t ngay l\341\272\255p t\341\273\251c.</span>\\n          </p>\\n        </div>\\n\\n        {/* B\341\273\221 c\341\273\245c 2 c\341\273\231t: C\341\273\231t tr\303\241i l\303\240 n\341\273\231i dung text, C\341\273\231t ph\341\272\243i l\303\240 h\303\254nh \341\272\243nh \304\221\341\273\203 blank */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center\\\">\\n          \\n          {/* C\341\273\231t tr\303\241i (7 cols): C\303\241c \304\221o\341\272\241n v\304\203n truy\341\273\201n c\341\272\243m h\341\273\251ng */}\\n          <div className=\\\"lg:col-span-7 flex flex-col gap-6 font-[\'Space_Grotesk\'] text-[17px] sm:text-[19px] leading-[28px] sm:leading-[32px] text-neutral-800\\\">\\n            {/* Box 1: L\341\273\235i cam k\341\272\277t c\341\272\247m tay ch\341\273\211 vi\341\273\207c */}\\n            <div className=\\\"border-l-4 border-[#191A23] pl-5 sm:pl-6 py-1\\\">\\n              <p>\\n                T\303\264i kh\303\264ng l\303\252n b\341\273\245c \304\221\341\273\203 thuy\341\272\277t gi\341\272\243ng.{\' \'}\\n                <strong className=\\\"font-bold text-black\\\">\\n                  T\303\264i ng\341\273\223i c\341\272\241nh b\341\272\241n \342\200\223 m\341\273\237 \304\221i\341\273\207n tho\341\272\241i, d\341\273\261ng h\341\273\207 th\341\273\221ng, \304\221\341\273\203 b\341\272\241n t\341\273\261 tay l\303\240m \304\221\306\260\341\273\243c.\\n                </strong>\\n              </p>\\n            </div>\\n\\n            {/* Box 2: Kh\341\272\263ng \304\221\341\273\213nh t\303\255nh chuy\341\273\203n \304\221\341\273\225i th\341\273\261c t\341\272\277 */}\\n            <div className=\\\"bg-[#F3F3F3] border border-[#191A23] rounded-[24px] p-5 sm:p-7 positivus-shadow\\\">\\n              <p className=\\\"font-bold text-[18px] sm:text-[20px] text-black flex items-start gap-2.5\\\">\\n                <span className=\\\"text-xl sm:text-2xl shrink-0\\\">\342\234\250</span>\\n                <span>Ch\306\260\306\241ng tr\303\254nh 2 ng\303\240y n\303\240y KH\303\224NG ph\341\272\243i m\341\273\231t kh\303\263a h\341\273\215c v\303\264 th\306\260\341\273\237ng v\303\264 ph\341\272\241t.</span>\\n              </p>\\n            </div>\\n\\n            {/* Box 3: C\306\241 h\341\273\231i chuy\341\273\203n \304\221\341\273\225i tho\303\241t kh\341\273\217i m\303\264 h\303\254nh c\305\251 */}\\n            <div className=\\\"bg-[#191A23] text-white rounded-[24px] p-6 sm:p-8 positivus-shadow\\\">\\n              <p className=\\\"text-[17px] sm:text-[19px] leading-[28px] sm:leading-[32px] text-white/95\\\">\\n                \304\220\303\242y l\303\240 cu\341\273\231c chuy\341\273\203n \304\221\341\273\225i th\341\272\255t s\341\273\261 \342\200\223 d\303\240nh cho b\341\272\241n, ng\306\260\341\273\235i mu\341\273\221n tho\303\241t kh\341\273\217i m\303\264 h\303\254nh c\305\251, v\303\240 s\341\273\237 h\341\273\257u ngay{\' \'}\\n                <span className=\\\"text-[#B9FF66] font-bold italic\\\">\342\200\234v\305\251 kh\303\255 ki\341\272\277m th\303\252m 100 tri\341\273\207u/th\303\241ng\342\200\235</span>{\' \'}\\n                <strong className=\\\"font-bold text-white underline decoration-[#B9FF66] decoration-2 underline-offset-4\\\">\\n                  m\303\240 kh\303\264ng c\341\272\247n bi\341\272\277t c\303\264ng ngh\341\273\207.\\n                </strong>\\n              </p>\\n            </div>\\n\\n            {/* N\303\272t CTA gi\341\273\257 ch\341\273\227 */}\\n            {onCtaClick && (\\n              <div className=\\\"pt-2\\\">\\n                <button\\n                  o