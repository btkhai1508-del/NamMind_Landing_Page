            name: "run_command"
            arguments_json: "{\"CommandLine\":\"node -e \'\\nconst sharp = require(\\\"sharp\\\");\\n\\nasync function createPerfectCrop() {\\n  const img = sharp(\\\"public/assets/aistudio/2_88a1ec16.png\\\");\\n  // Trim image first\\n  const trimmed = await img.trim().toBuffer({ resolveWithObject: true });\\n  const w = trimmed.info.width;\\n  const h = trimmed.info.height;\\n  \\n  // Height 2310 gives complete hands and stops right at navel line\\n  const cropHeight = 2310;\\n  \\n  // Extract from 0 to 2310\\n  const cropped = await sharp(trimmed.data)\\n    .extract({ left: 0, top: 0, width: w, height: cropHeight })\\n    .toBuffer();\\n    \\n  // Add a balanced 40px padding on top so hair has breathing room and never gets clipped by container\\n  const withPadding = await sharp(cropped)\\n    .extend({\\n      top: 40,\\n      bottom: 0,\\n      left: 20,\\n      right: 20,\\n      background: { r: 0, g: 0, b: 0, alpha: 0 }\\n    })\\n    .png()\\n    .toFile(\\\"public/assets/aistudio/namanh_portrait_cropped.png\\\");\\n    \\n  console.log(\\\"Successfully created namanh_portrait_cropped.png\\\");\\n}\\ncreatePerfectCrop();\\n\'\", \"Cwd\":\"/app/applet\", \"IsDaemon\":false, \"WaitMsBeforeAsync\":2000, \"toolAction\":\"Creating perfect crop image\", \"toolSummary\":\"Creating cropped portrait image\"}"
