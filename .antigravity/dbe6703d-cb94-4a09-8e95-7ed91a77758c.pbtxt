    replacement_infos {
      original_chunk {
        target_content: "// Positivus Logo with Starburst icon and Bold Space Grotesk text\nexport const PositivusLogo: React.FC<{ className?: string; color?: string; inverted?: boolean }> = ({\n  className = \'h-9\',\n  color = \'#000000\',\n  inverted = false,\n}) => {\n  const fillColor = inverted ? \'#FFFFFF\' : color;\n  return (\n    <div className={`flex items-center gap-3 select-none ${className}`}>\n      {/* 4-point geometric star emblem */}\n      <svg\n        width=\"36\"\n        height=\"36\"\n        viewBox=\"0 0 36 36\"\n        fill=\"none\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n        className=\"shrink-0\"\n      >\n        <path\n          d=\"M18 0L22.5 13.5L36 18L22.5 22.5L18 36L13.5 22.5L0 18L13.5 13.5L18 0Z\"\n          fill={fillColor}\n        />\n        <circle cx=\"18\" cy=\"18\" r=\"4.5\" fill={inverted ? \'#000000\' : \'#B9FF66\'} />\n      </svg>\n      {/* Brand Text */}\n      <span\n        style={{ color: fillColor }}\n        className=\"font-[\'Space_Grotesk\'] text-[28px] font-bold tracking-tight leading-none\"\n      >\n        Positivus\n      </span>\n    </div>\n  );\n};"
        replacement_content: "// Namind Wordmark Logo (clean typography without the star/dart icon)\nexport const NamindLogo: React.FC<{ className?: string; color?: string; inverted?: boolean }> = ({\n  className = \'h-9\',\n  color = \'#000000\',\n  inverted = false,\n}) => {\n  const fillColor = inverted ? \'#FFFFFF\' : color;\n  return (\n    <div className={`flex items-center select-none ${className}`}>\n      <span\n        style={{ color: fillColor }}\n        className=\"font-[\'Space_Grotesk\'] text-[30px] font-bold tracking-tight leading-none\"\n      >\n        Namind\n      </span>\n    </div>\n  );\n};\n\nexport const PositivusLogo = NamindLogo;"
        start_line: 3
        end_line: 37
      }
