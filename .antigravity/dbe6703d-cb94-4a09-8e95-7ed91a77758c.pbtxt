    content: "  return (\n    <section className=\"w-full pt-4 pb-8 sm:pt-8 sm:pb-14 overflow-hidden\">\n      <div className=\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col-reverse lg:flex-row items-center justify-between gap-8 lg:gap-12\">\n          {/* Left Text Block */}\n          <div className=\"w-full lg:max-w-[560px] flex flex-col items-start gap-6 sm:gap-7\">\n            {/* Title */}\n            <h1 className=\"font-[\'Space_Grotesk\'] font-bold text-[28px] sm:text-[36px] lg:text-[42px] leading-[38px] sm:leading-[48px] lg:leading-[52px] text-black tracking-tight uppercase\">\n              <span className=\"block\">\n                TH\341\273\254 TH\303\201CH 2 NG\303\200Y - D\303\222NG TI\341\273\200N 100 TRI\341\273\206U/ TH\303\201NG T\341\273\252 AFFILIATE\n              </span>\n              <span className=\"block mt-2 sm:mt-2.5\">\n                CH\341\273\210 C\341\272\246N BI\341\272\276T B\341\272\244M \304\220I\341\273\206N THO\341\272\240I (MI\341\273\204N PH\303\215)\n              </span>\n            </h1>\n\n            {/* Paragraph Content */}\n            <div className=\"flex flex-col gap-3 font-[\'Space_Grotesk\'] font-normal text-[17px] sm:text-[19px] leading-[26px] sm:leading-[28px] text-[#191A23]\">\n              <p className=\"font-medium text-black\">\n                Kh\303\264ng h\341\273\215c l\303\275 thuy\341\272\277t. 2 ng\303\240y \304\221\341\273\247 \304\221\341\273\203 b\341\272\255t m\303\264 h\303\254nh Affiliate v\303\240 t\341\272\241o d\303\262ng ti\341\273\201n 100 tri\341\273\207u/th\303\241ng.\n              </p>\n              <p className=\"text-neutral-700\">\n                Kh\303\264ng c\341\272\247n gi\341\273\217i. Kh\303\264ng c\341\272\247n b\341\272\261ng c\341\272\245p. Ch\341\273\211 c\341\272\247n \304\221i\341\273\207n tho\341\272\241i b\341\272\241n c\303\263 wifi\n              </p>\n            </div>\n\n            {/* CTA Button: Nh\341\272\245n v\303\240o \304\221\303\242y \304\221\341\273\203 gi\341\273\257 ch\341\273\227 ngay b\303\242y gi\341\273\235 */}\n            <button\n              onClick={onCtaClick}\n              className=\"mt-2 font-[\'Space_Grotesk\'] text-[17px] sm:text-[19px] font-bold text-white bg-[#191A23] rounded-[14px] px-[32px] py-[19px] hover:bg-[#B9FF66] hover:text-[#191A23] transition-all duration-200 cursor-pointer shadow-md hover:shadow-xl hover:-translate-y-0.5 border-2 border-[#191A23] text-center\"\n            >\n              Nh\341\272\245n v\303\240o \304\221\303\242y \304\221\341\273\203 gi\341\273\257 ch\341\273\227 ngay b\303\242y gi\341\273\235\n            </button>\n          </div>\n\n          {/* Right Image: Ch\303\242n dung to r\303\265, th\341\272\245y tr\341\273\215n v\341\272\271n \304\221\341\272\247u, m\341\272\245t ph\341\272\247n c\303\271i tr\341\273\217 */}\n          <div className=\"w-full lg:w-1/2 flex justify-center lg:justify-end shrink-0 relative\">\n            <div className=\"relative w-full max-w-[420px] sm:max-w-[480px] lg:max-w-[530px] flex items-center justify-center\">\n              {/* Subtle background glow */}\n              <div className=\"absolute inset-4 rounded-full bg-[#B9FF66]/25 blur-3xl -z-10\" />\n\n              {/* Cropped & Framed Container */}\n              <div className=\"relative w-full h-[430px] sm:h-[475px] lg:h-[495px] flex items-start justify-center overflow-hidden\">\n                <img\n                  src=\"/assets/aistudio/2_88a1ec16.png\"\n                  alt=\"Ch\303\242n dung \304\221\341\272\241i di\341\273\207n Th\341\273\255 th\303\241ch Affiliate\"\n                  className=\"w-full h-auto aspect-square object-contain object-top scale-[1.36] sm:scale-[1.4] lg:scale-[1.44] origin-top translate-y-[-2%] drop-shadow-[0_20px_35px_rgba(0,0,0,0.18)] select-none pointer-events-none\"\n                />\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>"
