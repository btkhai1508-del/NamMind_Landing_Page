    end_line: 44
    content: "import React from \'react\';\n\n// Positivus Logo with Starburst icon and Bold Space Grotesk text\nexport const PositivusLogo: React.FC<{ className?: string; color?: string; inverted?: boolean }> = ({\n  className = \'h-9\',\n  color = \'#000000\',\n  inverted = false,\n}) => {\n  const fillColor = inverted ? \'#FFFFFF\' : color;\n  return (\n    <div className={`flex items-center gap-3 select-none ${className}`}>\n      {/* 4-point geometric star emblem */}\n      <svg\n        width=\"36\"\n        height=\"36\"\n        viewBox=\"0 0 36 36\"\n        fill=\"none\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n        className=\"shrink-0\"\n      >\n        <path\n          d=\"M18 0L22.5 13.5L36 18L22.5 22.5L18 36L13.5 22.5L0 18L13.5 13.5L18 0Z\"\n          fill={fillColor}\n        />\n        <circle cx=\"18\" cy=\"18\" r=\"4.5\" fill={inverted ? \'#000000\' : \'#B9FF66\'} />\n      </svg>\n      {/* Brand Text */}\n      <span\n        style={{ color: fillColor }}\n        className=\"font-[\'Space_Grotesk\'] text-[28px] font-bold tracking-tight leading-none\"\n      >\n        Positivus\n      </span>\n    </div>\n  );\n};\n\n// Diagonal arrow icon inside circle\nexport const ArrowUpRightIcon: React.FC<{\n  circleBg?: string;\n  arrowColor?: string;\n  className?: string;\n}> = ({ circleBg = \'#191A23\', arrowColor = \'#B9FF66\', className = \'w-[41px] h-[41px]\' }) => (\n  <div\n    className={`relative rounded-full flex items-center justify-center shrink-0 transition-transform duration-200 group-hover:scale-105 ${className}`}"
    num_lines: 176
