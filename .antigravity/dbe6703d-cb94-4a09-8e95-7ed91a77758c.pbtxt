    action_spec {
      create_file {
        instruction: "import React from \'react\';\n\ninterface CtaBannerProps {\n  onCtaClick?: () => void;\n}\n\nexport const CtaBanner: React.FC<CtaBannerProps> = ({ onCtaClick }) => {\n  return (\n    <section className=\"w-full py-8 sm:py-14\">\n      <div className=\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\">\n        {/* Template chu\341\272\251n Figma Positivus: n\341\273\201n #F3F3F3, bo g\303\263c 45px, border & shadow \304\221\341\272\267c tr\306\260ng */}\n        <div className=\"bg-[#F3F3F3] border-2 border-[#191A23] rounded-[45px] p-8 sm:p-12 lg:p-14 positivus-shadow flex flex-col lg:flex-row items-center justify-between gap-10 overflow-hidden\">\n          \n          {/* C\341\273\231t b\303\252n tr\303\241i: N\341\273\231i dung c\304\203n tr\303\241i */}\n          <div className=\"w-full lg:max-w-[620px] flex flex-col items-start text-left gap-5 sm:gap-6 z-10\">\n            {/* Ti\303\252u \304\221\341\273\201 2 d\303\262ng */}\n            <h2 className=\"font-[\'Space_Grotesk\'] text-black tracking-tight\">\n              <span className=\"block font-bold text-[20px] sm:text-[24px] lg:text-[28px] leading-[28px] sm:leading-[34px] text-neutral-900 mb-1\">\n                N\341\272\277u b\341\272\241n th\341\272\245y m\303\254nh trong b\341\272\245t k\341\273\263 d\303\262ng n\303\240o \341\273\237 tr\303\252n...\n              </span>\n              <span className=\"block font-black text-[22px] sm:text-[28px] lg:text-[34px] leading-[30px] sm:leading-[38px] uppercase text-black\">\n                Th\303\254 TH\341\273\254 TH\303\201CH 2 NG\303\200Y n\303\240y sinh ra ch\303\255nh x\303\241c cho b\341\272\241n!\n              </span>\n            </h2>\n\n            {/* Tr\303\255ch d\341\272\253n / Subtitle */}\n            <p className=\"font-[\'Space_Grotesk\'] text-[17px] sm:text-[19px] lg:text-[21px] leading-[26px] sm:leading-[30px] text-neutral-800\">\n              <span className=\"font-medium\">V\303\240 b\341\272\241n s\341\272\275 t\341\273\261 h\341\273\217i: </span>\n              <span className=\"font-bold italic\">\"T\341\272\241i sao \304\221\341\272\277n gi\341\273\235 n\303\240y m\303\254nh m\341\273\233i bi\341\272\277t \304\221\341\272\277n Affiliate\"</span>\n            </p>\n\n            {/* K\303\252u g\341\273\215i h\303\240nh \304\221\341\273\231ng */}\n            <div className=\"font-[\'Space_Grotesk\'] text-[15px] sm:text-[17px] lg:text-[18px] leading-[24px] sm:leading-[28px] text-neutral-900\">\n              <p className=\"font-bold flex items-start gap-2\">\n                <span className=\"text-lg sm:text-xl shrink-0 leading-none\">\360\237\221\211</span>\n                <span>H\303\243y b\341\272\245m n\303\272t b\303\252n d\306\260\341\273\233i \304\221\341\273\203 gi\303\240nh 1 trong 7 su\341\272\245t cu\341\273\221i c\303\271ng \342\200\223 tr\306\260\341\273\233c khi ch\306\260\306\241ng tr\303\254nh n\303\240y \304\221\303\263ng l\341\272\241i!</span>\n              </p>\n            </div>\n\n            {/* N\303\272t xanh n\341\273\225i b\341\272\255t v\341\273\233i 2 d\303\262ng text v\303\240 m\305\251i t\303\252n \302\273 */}\n            <button\n              onClick={onCtaClick}\n              className=\"mt-2 w-full sm:w-auto bg-[#0E7E49] hover:bg-[#0a663b] text-white rounded-[16px] py-4 px-6 sm:px-8 transition-all duration-200 cursor-pointer shadow-xl hover:shadow-2xl hover:-translate-y-1 active:translate-y-0 border-2 border-[#095f36] flex flex-col items-center sm:items-start justify-center gap-1 group\"\n            >\n              <span className=\"font-[\'Space_Grotesk\'] font-bold text-[18px] sm:text-[21px] leading-tight flex items-center gap-2\">\n                <span>Tham gia th\341\273\255 th\303\241ch 2 Ng\303\240y Affiliate</span>\n                <span className=\"text-xl sm:text-2xl font-black group-hover:translate-x-1.5 transition-transform leading-none\">\302\273</span>\n              </span>\n              <span className=\"font-[\'Space_Grotesk\'] font-normal text-[13px] sm:text-[14px] text-white/90 leading-tight\">\n                Nh\341\272\245n v\303\240o \304\221\303\242y \304\221\341\273\203 \304\221\306\260\341\273\243c gi\341\273\257 ch\341\273\227 ngay b\303\242y gi\341\273\235\n              </span>\n            </button>\n          </div>\n\n          {/* C\341\273\231t b\303\252n ph\341\272\243i: Ch\341\273\253a kho\341\272\243ng tr\341\273\221ng \304\221\341\273\203 ch\303\250n h\303\254nh \341\272\243nh sau n\303\240y */}\n          <div className=\"w-full lg:w-[440px] shrink-0 flex items-center justify-center\">\n            <div className=\"w-full min-h-[250px] sm:min-h-[300px] border-2 border-dashed border-[#191A23]/25 rounded-[32px] bg-white/60 flex flex-col items-center justify-center p-6 text-center hover:bg-white/80 transition-colors\">\n              <div className=\"w-14 h-14 rounded-full bg-[#191A23]/5 flex items-center justify-center mb-3 text-[#191A23]/40\">\n                <svg className=\"w-7 h-7\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n                  <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"1.5\" d=\"M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z\" />\n                </svg>\n              </div>\n              <p className=\"font-[\'Space_Grotesk\'] font-medium text-[15px] text-[#191A23]/70\">\n                Khu v\341\273\261c h\303\254nh \341\272\243nh\n              </p>\n              <p className=\"font-[\'Space_Grotesk\'] text-[13px] text-[#191A23]/40 mt-1\">\n                (\304\220ang ch\341\273\253a tr\341\273\221ng \304\221\341\273\203 b\341\272\241n g\341\272\257n \341\272\243nh v\303\240o sau)\n              </p>\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/CtaBanner.tsx"
        }
        overwrite: true
      }
    }
