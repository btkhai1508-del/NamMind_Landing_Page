  view_file {
    absolute_path_uri: "file:///src/components/Testimonials.tsx"
    end_line: 140
    content: "import React, { useState } from \'react\';\nimport { SectionHeading } from \'./SectionHeading\';\nimport { PositivusStar } from \'./PositivusIcons\';\n\ninterface TestimonialItem {\n  id: number;\n  quote: string;\n  name: string;\n  title: string;\n}\n\nexport const Testimonials: React.FC = () => {\n  const [currentIndex, setCurrentIndex] = useState(0);\n\n  const testimonials: TestimonialItem[] = [\n    {\n      id: 1,\n      quote:\n        \'\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse.\"\',\n      name: \'Subtitle 32\',\n      title: \'Subtitle 33\',\n    },\n    {\n      id: 2,\n      quote:\n        \'\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate.\"\',\n      name: \'Subtitle 34\',\n      title: \'Subtitle 35\',\n    },\n    {\n      id: 3,\n      quote:\n        \'\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse.\"\',\n      name: \'Subtitle 36\',\n      title: \'Subtitle 37\',\n    },\n    {\n      id: 4,\n      quote:\n        \'\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.\"\',\n      name: \'Subtitle 38\',\n      title: \'Subtitle 39\',\n    },\n    {\n      id: 5,\n      quote:\n        \'\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate.\"\',\n      name: \'Subtitle 40\',\n      title: \'Subtitle 41\',\n    },\n  ];\n\n  const handlePrev = () => {\n    setCurrentIndex((prev) => (prev === 0 ? testimonials.length - 1 : prev - 1));\n  };\n\n  const handleNext = () => {\n    setCurrentIndex((prev) => (prev === testimonials.length - 1 ? 0 : prev + 1));\n  };\n\n  const current = testimonials[currentIndex];\n\n  return (\n    <section className=\"w-full py-12 sm:py-16\">\n      <div className=\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\">\n        <SectionHeading\n          title=\"Section Title 5\"\n          description=\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\"\n          maxWidthDesc=\"max-w-[473px]\"\n        />\n\n        {/* Dark Container for Testimonials */}\n        <div className=\"bg-[#191A23] rounded-[45px] py-12 sm:py-16 lg:py-20 px-6 sm:px-12 flex flex-col items-center justify-between min-h-[560px] sm:min-h-[625px]\">\n          {/* Active Testimonial Speech Bubble */}\n          <div className=\"w-full max-w-[606px] flex flex-col items-start transition-all duration-300\">\n            {/* Bubble Box */}\n            <div className=\"relative w-full bg-[#21241D] border-2 border-white sm:border-[#B9FF66] rounded-[45px] p-8 sm:p-12 mb-6\">\n              <p className=\"font-[\'Space_Grotesk\'] font-normal text-[16px] sm:text-[18px] leading-[23px] text-white\">\n                {current.quote}\n              </p>\n\n              {/* Triangle Tail pointing down */}\n              <div className=\"absolute -bottom-4 left-14 sm:left-16 w-0 h-0 border-l-[16px] border-l-transparent border-r-[16px] border-r-transparent border-t-[16px] border-t-[#21241D]\" />\n              <div className=\"absolute -bottom-5 left-14 sm:left-16 w-0 h-0 border-l-[16px] border-l-transparent border-r-[16px] border-r-transparent border-t-[16px] border-t-white sm:border-t-[#B9FF66] -z-10\" />\n            </div>\n\n            {/* Author Attribution */}\n            <div className=\"ml-14 sm:ml-16 mt-2\">\n              <h4 className=\"font-[\'Space_Grotesk\'] font-medium text-[20px] leading-[26px] text-[#B9FF66]\">\n                {current.name}\n              </h4>\n              <p className=\"font-[\'Space_Grotesk\'] font-normal text-[16px] sm:text-[18px] leading-[23px] text-white\">\n                {current.title}\n              </p>\n            </div>\n          </div>\n\n          {/* Navigation Controls: Prev Arrow, 5 Star Indicators, Next Arrow */}\n          <div className=\"w-full max-w-[564px] flex items-center justify-between mt-12 sm:mt-16 px-4\">\n            {/* Arrow Left */}\n            <button\n              onClick={handlePrev}\n              className=\"text-white/60 hover:text-white transition-colors p-2 cursor-pointer\"\n              aria-label=\"Previous testimonial\"\n            >\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M15 19l-7-7 7-7\" />\n              </svg>\n            </button>\n\n            {/* 5 Star indicators */}\n            <div className=\"flex items-center gap-4 sm:gap-5\">\n              {testimonials.map((_, idx) => (\n                <button\n                  key={idx}\n                  onClick={() => setCurrentIndex(idx)}\n                  className=\"cursor-pointer transition-transform hover:scale-125\"\n                  aria-label={`Go to slide ${idx + 1}`}\n                >\n                  <PositivusStar active={currentIndex === idx} size={16} />\n                </button>\n              ))}\n            </div>\n\n            {/* Arrow Right */}\n            <button\n              onClick={handleNext}\n              className=\"text-white/60 hover:text-white transition-colors p-2 cursor-pointer\"\n              aria-label=\"Next testimonial\"\n            >\n              <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.5\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" d=\"M9 5l7 7-7 7\" />\n              </svg>\n            </button>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
