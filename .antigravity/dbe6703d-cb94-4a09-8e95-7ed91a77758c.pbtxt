        instruction: "import React from \'react\';\n\ninterface AffiliateModelSectionProps {\n  onCtaClick?: () => void;\n}\n\nexport const AffiliateModelSection: React.FC<AffiliateModelSectionProps> = ({ onCtaClick }) => {\n  return (\n    <section className=\"w-full py-12 sm:py-20 bg-white\">\n      <div className=\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Ti\303\252u \304\221\341\273\201 & ph\341\273\245 \304\221\341\273\201 ch\303\255nh c\341\273\247a Section tr\341\272\257ng */}\n        <div className=\"max-w-[980px] mx-auto text-center mb-10 sm:mb-16\">\n          {/* Badge ti\303\252u \304\221\341\273\201 phong c\303\241ch Positivus */}\n          <div className=\"inline-flex items-center px-[10px] py-1 bg-[#B9FF66] rounded-[8px] mb-4\">\n            <h2 className=\"font-[\'Space_Grotesk\'] font-bold text-[22px] sm:text-[30px] md:text-[36px] leading-[32px] sm:leading-[40px] md:leading-[46px] text-black tracking-tight\">\n              M\341\273\231t m\303\264 h\303\254nh Affiliate M\341\273\232I cho ng\306\260\341\273\235i kh\303\264ng c\341\272\247n bi\341\272\277t c\303\264ng ngh\341\273\207!\n            </h2>\n          </div>\n\n          {/* D\303\262ng m\303\264 t\341\272\243 1 */}\n          <p className=\"font-[\'Space_Grotesk\'] text-[17px] sm:text-[20px] md:text-[22px] leading-[26px] sm:leading-[32px] text-neutral-800\">\n            <span>Ch\341\273\211 trong 2 ng\303\240y, </span>\n            <strong className=\"font-bold text-black\">b\341\272\241n copy \342\200\223 d\303\241n ngay t\341\272\241i l\341\273\233p: </strong>\n            <span>c\303\263 ph\341\273\205u, c\303\263 website, c\303\263 n\341\273\231i dung ch\341\272\241y s\341\272\265n\342\200\246</span>\n          </p>\n\n          {/* D\303\262ng k\341\272\277t qu\341\272\243 ra kh\303\241ch th\341\272\255t, ti\341\273\201n th\341\272\255t */}\n          <p className=\"mt-2.5 font-[\'Space_Grotesk\'] font-bold text-[18px] sm:text-[21px] md:text-[23px] t