  user_input {
    user_response: "Crop body n\303\263 t\341\273\253 c\303\241i ph\341\272\247n r\341\273\221n tr\341\273\237 l\303\252n v\303\240 c\304\203n c\303\241i \304\221\341\272\247u b\341\272\261ng c\303\241i top c\341\273\247a title nha\nC\303\241i title c\304\203n l\341\273\201 gi\341\273\257a \341\273\237 pop up \304\221i\341\273\201n form\nSau khi nh\341\272\245n n\303\272t g\341\273\255i v\303\251 mi\341\273\205n ph\303\255 cho t\303\264i\nth\303\254 sang trang m\341\273\233i (Same template)\nth\303\252m th\303\264ng tin l\303\240\n[TITLE]\nCH\303\232C M\341\273\252NG,\nB\341\272\240N \304\220\303\203 L\303\200M \304\220\306\257\341\273\242C R\341\273\222I!\nB\306\260\341\273\233c cu\341\273\221i c\303\271ng, Ch\341\273\211 trong nh\303\263m k\303\255n Zalo ch\303\272ng t\303\264i m\341\273\233i cung c\341\272\245p l\341\273\213ch h\341\273\215c, chi\341\272\277n l\306\260\341\273\243c, b\303\240i t\341\272\255p, t\303\240i li\341\273\207u v\303\240 \360\237\216\201qu\303\240 t\341\272\267ng l\303\252n \304\221\341\272\277n 125.970.000 \304\221....\n\342\232\240\357\270\217 (M\341\273\231t nh\303\263m duy nh\341\272\245t, m\341\273\231t n\306\241i duy nh\341\272\245t, ch\303\272ng t\303\264i ch\341\273\211 duy\341\273\207t trong 3 ph\303\272t)\n[TIMER]\nNh\306\260 h\303\254nh \341\272\243nh nh\306\260ng chimnrh cho m\303\254nh l\303\240 10 ph\303\272t\n[N\303\232T NH\341\272\244N]\nB\341\272\244M \304\220\341\273\202 V\303\200O NH\303\223M ZALO K\303\215N\n(Kh\303\264ng v\303\240o nh\303\263m kh\303\264ng \304\221\306\260\341\273\243c h\341\273\215c nhanh tay b\341\272\245m v\303\240o nh\303\263m ngay nh\303\251)\nk\303\250m link n\303\240yhttps://zalo.me/g/a2y2x036pqkwzig7u9ri\nTh\303\252m png qr n\303\263m zalo n\303\240y nha\nR\303\271i k\303\250m n\341\273\231i dung d\306\260\341\273\233i (Qu\303\251t m\303\243 QR-code \360\237\221\206 \304\221\341\273\203 \n\304\221\306\260\341\273\243c v\303\240o nh\303\263m lu\303\264n nh\303\251)\n[AIS_METADATA_SECTION_START]