      metadata {
        key: "task_description"
        value: "node -e \'\nconst sharp = require(\"sharp\");\n\nasync function analyze() {\n  const img = sharp(\"public/assets/aistudio/2_88a1ec16.png\");\n  // Trim image first to remove outer transparent padding\n  const trimmedBuf = await img.trim().toBuffer();\n  const trimmedMeta = await sharp(trimmedBuf).metadata();\n  console.log(\"Trimmed dimensions:\", trimmedMeta.width, \"x\", trimmedMeta.height);\n  \n  // Now let us save a crop of trimmed:\n  // Total height is ~2794.\n  // Head is at top (0 to ~800).\n  // Chest/arms (800 to ~1600).\n  // Hands are around 1600 to 2200.\n  // Bottom of hands / navel is around 2100 - 2300.\n  // Lower blazer / hips are 2300 - 2794.\n  \n  // Lets generate 3 candidate crops from trimmedBuf:\n  // Crop 1: height 75% of trimmedMeta.height (cut just under hands)\n  // Crop 2: height 78% of trimmedMeta.height\n  // Crop 3: height 82% of trimmedMeta.height\n  \n  console.log(\"Heights:\", Math.round(trimmedMeta.height * 0.75), Math.round(trimmedMeta.height * 0.78), Math.round(trimmedMeta.height * 0.82));\n}\nanalyze();\n\'"
