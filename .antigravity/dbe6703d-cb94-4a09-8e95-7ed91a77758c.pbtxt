    content: "import React from \'react\';\nimport { CtaIllustration } from \'./PositivusIllustrations\';\n\ninterface CtaBannerProps {\n  onCtaClick?: () => void;\n}\n\nexport const CtaBanner: React.FC<CtaBannerProps> = ({ onCtaClick }) => {\n  return (\n    <section className=\"w-full py-10 sm:py-16\">\n      <div className=\"max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"relative bg-[#F3F3F3] rounded-[45px] p-8 sm:p-14 lg:p-16 flex flex-col lg:flex-row items-center justify-between gap-10 overflow-hidden\">\n          {/* Left Text and CTA button */}\n          <div className=\"max-w-[500px] flex flex-col items-start gap-6 sm:gap-7 z-10\">\n            <h3 className=\"font-[\'Space_Grotesk\'] font-medium text-[28px] sm:text-[30px] leading-[36px] sm:leading-[38px] text-black\">\n              Subtitle\n            </h3>\n            <p className=\"font-[\'Space_Grotesk\'] font-normal text-[16px] sm:text-[18px] leading-[23px] text-black\">\n              Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.\n            </p>\n            <button\n              onClick={onCtaClick}\n              className=\"font-[\'Space_Grotesk\'] text-[18px] sm:text-[20px] font-normal text-white bg-[#191A23] rounded-[14px] px-[35px] py-[20px] hover:bg-[#B9FF66] hover:text-[#191A23] transition-all duration-200 cursor-pointer whitespace-nowrap\"\n            >\n              Get Started\n            </button>\n          </div>\n\n          {/* Right Vector Illustration */}\n          <div className=\"shrink-0 flex items-center justify-center lg:justify-end w-full lg:w-auto\">\n            <CtaIllustration />\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 38
    num_bytes: 1738
    line_range_bytes: 1738
  }
}
